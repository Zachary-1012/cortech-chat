# Cortech Chat 生产环境模板
# 复制为服务器上的 /etc/cortech-chat.env，或 deploy/env.production（不要提交真实密钥）
#
# 数据目录必须在程序目录 / 镜像外面。

CORTECH_SAAS=1
CORTECH_DATA_DIR=/var/lib/cortech
CORTECH_HOST=127.0.0.1
CORTECH_PORT=8000

# 仅在全站 HTTPS（或 nginx 把 https 回源时浏览器看到 https）时设为 1
CORTECH_COOKIE_SECURE=0

# 真实采集保持关闭。只有在没有小红书登录态、需要看闭环样例时才设为 1。
CORTECH_COLLECTION_FIXTURE=0

# 本人 Cookie 握手：CORTECH_SAAS=1 时默认开启。要关掉就写 0。
# CORTECH_ENABLE_COOKIE_HANDSHAKE=1

# AI（可选）。不填则创作 / 聊天走规则兜底。
# GROQ_API_KEY=
# GEMINI_API_KEY=

# 追加 CORS，逗号分隔。同源部署可以留空。
# XHS_CORS_ORIGINS=https://chat.example.com

# Cortech Chat 本地密钥与运行模板
#
# 用法：复制本文件为 monitor/.env，填入自己的 key。
#   copy monitor\.env.example monitor\.env      （Windows）
#   cp monitor/.env.example monitor/.env        （Linux / macOS）
#
# monitor/.env 已被 .gitignore 忽略，绝不会进入仓库。
# 也可以在「设置 → 模型配置」页里填写并保存，效果等同（保存在 data/ai_config.json）。

# ---- Groq（默认主力 Provider）----
# 申请地址：https://console.groq.com/keys
GROQ_API_KEY=

# ---- Google Gemini（备用 Provider）----
# 申请地址：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- 多 Provider 覆盖（可选）----
# 填写后对应 Provider 的 base_url / model 会被覆盖
# GROQ_AI_BASE_URL=https://api.groq.com/openai/v1
# GROQ_AI_MODEL=llama-3.3-70b-versatile
# GEMINI_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_AI_MODEL=gemini-2.5-flash

# ---- 自定义 OpenAI 兼容网点（可选）----
# CUSTOM_AI_BASE_URL=https://your-gateway/v1
# CUSTOM_API_KEY=
# CUSTOM_AI_MODEL=

# ---- 显式覆盖当前生效 Provider（优先级最高，交付/容器场景用）----
# XHS_AI_BASE_URL=
# XHS_AI_API_KEY=
# XHS_AI_MODEL=

# ---- SaaS 运行（云 / VPS / 容器）----
# 数据目录放在程序目录之外。未设置时使用项目下的 data/
# CORTECH_DATA_DIR=/var/lib/cortech
# 历史别名，与 CORTECH_DATA_DIR 二选一：
# TKH_DATA_DIR=/var/lib/cortech
# 监听。未设置时 python -m monitor.app 默认 0.0.0.0:8000
# CORTECH_HOST=0.0.0.0
# CORTECH_PORT=8000
# 旧名仍可用（优先级低于 CORTECH_*）：
# XHS_HOST=127.0.0.1
# XHS_PORT=8000
# 本地样例采集（不访问小红书，只用于自检）：
# CORTECH_COLLECTION_FIXTURE=0
# 云上 SaaS。未单独设置握手开关时，本人 Cookie 握手默认开启：
# CORTECH_SAAS=1
# 生产模板见 deploy/env.production.example（数据目录在程序目录外）
# CORTECH_COOKIE_SECURE=1
# 用户本人确认后提交 Cookie 的握手。0 强制关闭，1 强制开启；留空则跟随 CORTECH_SAAS
# CORTECH_ENABLE_COOKIE_HANDSHAKE=1
# 只复用你自己指定的、已经登录的本地 profile，不代登录，默认关闭：
# CORTECH_ENABLE_BROWSER_USE=0
# CORTECH_BROWSER_USE_PROFILE=
# CORTECH_BROWSER_USE_CONCURRENCY=1
# CORTECH_BROWSER_USE_QUEUE=4
# 多账号：每个账号每天计入的采集条数，以及登录失效后暂停轮换的秒数
# CORTECH_ACCOUNT_DAILY_QUOTA=300
# CORTECH_ACCOUNT_SKIP_SEC=1800

# ---- 跨域白名单追加（可选，逗号分隔）----
# XHS_CORS_ORIGINS=

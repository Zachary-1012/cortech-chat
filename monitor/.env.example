# Chat Cortech 本地密钥模板
#
# 用法：复制本文件为 monitor/.env，填入自己的 key。
#   copy monitor\.env.example monitor\.env      （Windows）
#   cp monitor/.env.example monitor/.env        （Linux / macOS）
#
# monitor/.env 已被 .gitignore 忽略，绝不会进入仓库。
# 也可以在「设置 → 模型配置」页里填写并保存，效果等同（保存在 data/ai_config.json）。

# ---- Groq（默认主力 Provider）----
# 申请地址：https://console.groq.com/keys
GROQ_API_KEY=

# ---- Google Gemini（备用 Provider）----
# 申请地址：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- 多 Provider 覆盖（可选）----
# 填写后对应 Provider 的 base_url / model 会被覆盖
# GROQ_AI_BASE_URL=https://api.groq.com/openai/v1
# GROQ_AI_MODEL=llama-3.3-70b-versatile
# GEMINI_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_AI_MODEL=gemini-2.5-flash

# ---- 自定义 OpenAI 兼容网点（可选）----
# CUSTOM_AI_BASE_URL=https://your-gateway/v1
# CUSTOM_API_KEY=
# CUSTOM_AI_MODEL=

# ---- 显式覆盖当前生效 Provider（优先级最高，交付/容器场景用）----
# XHS_AI_BASE_URL=
# XHS_AI_API_KEY=
# XHS_AI_MODEL=

# ---- 服务监听（可选）----
# XHS_HOST=127.0.0.1
# XHS_PORT=8000

# ---- 跨域白名单追加（可选，逗号分隔）----
# XHS_CORS_ORIGINS=
